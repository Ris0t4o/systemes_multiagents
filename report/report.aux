\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: obstacle consensus magnitude vs.\ distance to the obstacle surface, decomposed into the linear term $k_\mathrm  {obs}(r_\mathrm  {safe} - d)$ and the barrier term $k_\mathrm  {bar}(r_\mathrm  {safe}/d - 1)$. The numerical clamp at $\varepsilon = 0.02\,r_\mathrm  {safe}$ caps the barrier at $\sim 25$\,m/s pre-saturation. Right: inter-drone 3D barrier magnitude vs.\ pairwise distance over the active band $[d_\mathrm  {min}, d_\mathrm  {act}]$. The shaded strip is the per-tick closure budget $2 v_\mathrm  {max} \Delta t = 0.06$\,m -- the barrier is already in the hundreds of m/s by the time a relative-closure step could cross it, which underwrites the discrete-time invariance argument of Sec.~\ref {sec:tp-shim}.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:barrier_curves}{{5}{14}{Left: obstacle consensus magnitude vs.\ distance to the obstacle surface, decomposed into the linear term $k_\mathrm {obs}(r_\mathrm {safe} - d)$ and the barrier term $k_\mathrm {bar}(r_\mathrm {safe}/d - 1)$. The numerical clamp at $\varepsilon = 0.02\,r_\mathrm {safe}$ caps the barrier at $\sim 25$\,m/s pre-saturation. Right: inter-drone 3D barrier magnitude vs.\ pairwise distance over the active band $[d_\mathrm {min}, d_\mathrm {act}]$. The shaded strip is the per-tick closure budget $2 v_\mathrm {max} \Delta t = 0.06$\,m -- the barrier is already in the hundreds of m/s by the time a relative-closure step could cross it, which underwrites the discrete-time invariance argument of Sec.~\ref {sec:tp-shim}}{figure.5}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Hide mode (oblique 3D). The seeker has just emitted a sighting from $(0, -4, 0.8)$ (south wall, ahead of obstacle 2). The four hiders' cones switch to gold (alert), each hider has been assigned a distinct far-side cover face, and the swarm converges within $\sim 3$\,s (well inside the 5\,s TTL).}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:hide_assignment}{{3}{11}{Hide mode (oblique 3D). The seeker has just emitted a sighting from $(0, -4, 0.8)$ (south wall, ahead of obstacle 2). The four hiders' cones switch to gold (alert), each hider has been assigned a distinct far-side cover face, and the swarm converges within $\sim 3$\,s (well inside the 5\,s TTL)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Same hide-mode instant viewed from straight above. Top-down makes the cover-face geometry unambiguous: each hider sits behind one obstacle face whose outward normal points \emph  {away} from the seeker's south-side sighting, and no two hiders share a face -- the visual signature of the injective min-cost matching.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:hide_assignment_topdown}{{4}{12}{Same hide-mode instant viewed from straight above. Top-down makes the cover-face geometry unambiguous: each hider sits behind one obstacle face whose outward normal points \emph {away} from the seeker's south-side sighting, and no two hiders share a face -- the visual signature of the injective min-cost matching}{figure.4}{}}
